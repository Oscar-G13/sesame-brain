<%- include('header', { title: 'Connect an assistant' }) %>
<main class="narrow consent"><div class="eyebrow">A CONNECTION YOU CONTROL</div><h1>Meet in the middle.</h1><p class="lede"><strong><%= client.client_name || 'An MCP client' %></strong> wants to connect to your shared brain.</p><div class="client-info"><span>Requested by</span><strong><%= redirectHost %></strong><% if(loopback) { %><small>This returns to an app on your device.</small><% } %></div><% if(error) { %><p role="alert" class="message error"><%= error %></p><% } %>
<form method="post" action="/authorize"><input type="hidden" name="_csrf" value="<%= csrf %>"><% Object.entries(oauthParams).forEach(([key,value]) => { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %>
<fieldset class="agent-picker"><legend>Which assistant is connecting right now?</legend><p class="field-help">This label attributes saved records and controls access. Keep using this connection across calls; you can rename it later.</p><div class="agent-options"><% ['maya','miles','simone','charlie'].forEach(agent => { %><label><input type="radio" name="agent_label" value="<%= agent %>" required><span><%= agent.charAt(0).toUpperCase()+agent.slice(1) %></span></label><% }) %><label class="other"><input type="radio" name="agent_label" value="other" required><span>Other</span></label></div><label class="small" for="custom-agent">Custom name, if you chose Other</label><input id="custom-agent" name="custom_agent" placeholder="e.g. claude" pattern="[a-z0-9-]{1,32}" maxlength="32" autocomplete="off"><p class="field-help">Lowercase letters, numbers, and hyphens.</p></fieldset>
<div class="consent-details"><strong>This connection can:</strong><ul><% if((oauthParams.scope || '').includes('brain:read')) { %><li>Read shared facts, activity, and memory backups.</li><li>Read notes and handoffs visible to this assistant.</li><% } %><% if((oauthParams.scope || '').includes('brain:write')) { %><li>Write notes, handoffs, facts, and memory backups.</li><li>Update or remove shared facts.</li><% } %></ul><p>Content stays on one server in Helsinki. You can export it, revoke access, or delete your account at any time. <a href="/privacy">Privacy details</a></p></div>
<div class="actions"><button class="primary" name="decision" value="approve" type="submit">Connect assistant →</button><button class="secondary" name="decision" value="deny" type="submit" formnovalidate>Cancel</button></div></form></main><%- include('footer') %>
