<%- include('header') %><main class="narrow"><a class="back-link" href="/login">← Sign in</a><div class="eyebrow">YOUR WAY BACK</div><h1>Use a recovery code.</h1><p class="lede">Enter one of the recovery codes you saved to choose a new password.</p><% if(error) { %><p class="message error" role="alert"><%= error %></p><% } %><form method="post" action="/recover" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" value="<%= typeof email==='string'?email:'' %>" required><label for="recovery-code">Recovery code</label><input id="recovery-code" name="recovery_code" autocomplete="off" spellcheck="false" required><label for="new-password">New password</label><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="1024" required><p class="field-help">At least 10 characters. This recovery code can only be used once.</p><button class="primary full" type="submit">Reset password</button></form></main><%- include('footer') %>
