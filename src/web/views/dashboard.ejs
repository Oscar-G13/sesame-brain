<%- include('dash-header') %><div class="dashboard-heading"><div><p class="overline"><span></span> YOUR PERSONAL INTELLIGENCE</p><h1>What are we moving forward?</h1><p class="heading-description"><%= total?'What you’ve shared with Brain. What changed. What’s ready to move forward.':'A fresh start. Build a shared record with the assistants you choose.' %></p></div><div class="heading-actions"><a class="dash-button outline" href="<%= brainLink('/dashboard/think') %>">Think with Brain ✳</a><a class="dash-button lime" href="<%= brainLink('/dashboard/projects/new') %>"><span aria-hidden="true">+</span> Start a project</a></div></div>
<% if(agents.length<2||total===0) { %><section class="dash-panel first-success"><div><p class="overline">YOUR FIRST SHARED MOMENT</p><h2>One detail.<br>Two different voices.</h2><p>Connect two assistants, save a useful detail with one, and ask the other to retrieve it from Brain.</p><div class="copy-row"><code><%= config.resource %></code><button type="button" class="copy-button" data-copy="<%= config.resource %>">Copy address</button></div><a class="panel-link" href="/docs">Open the connection guide →</a></div><ol class="first-success-steps"><li class="<%= agents.length?'complete':'' %>"><span><%= agents.length?'✓':'1' %></span><div><strong>Connect the first voice</strong><p><%= agents.length?agents[0].agent_label+' is connected.':'In Sesame, add this address under Agent Hub → Apps.' %></p></div></li><li class="<%= total?'complete':'' %>"><span><%= total?'✓':'2' %></span><div><strong>Save one real detail</strong><p>Ask: “Remember in Brain that my morning train leaves at 7:40.” Use a detail that is true for you.</p></div></li><li class="<%= agents.length>=2?'complete':'' %>"><span><%= agents.length>=2?'✓':'3' %></span><div><strong>Pick it up with another voice</strong><p><%= agents.length>=2?'Two voices are connected. Ask the second what Brain remembers.':'Connect a second assistant to this same Brain account, then ask it what Brain remembers.' %></p></div></li></ol><p class="onboarding-boundary">Brain records what is shared through its tools. It does not copy an assistant’s full conversation or native memory automatically.</p></section><% } %>
<div class="outcomes-grid"><section class="dash-panel outcome-panel"><p class="overline">NEEDS YOUR DECISION</p><h2><%= projects.reduce((sum,project)=>sum+Number(project.needs_review_count||0),0) %> <%= projects.reduce((sum,project)=>sum+Number(project.needs_review_count||0),0)===1?'item':'items' %> to review</h2><% const reviewProjects=projects.filter(project=>project.needs_review_count); if(!reviewProjects.length) { %><p>No project items are currently flagged. Changed constraints will point you to the work that needs another look.</p><% } else { %><ul><% reviewProjects.slice(0,3).forEach(project=>{ %><li><a href="<%= brainLink('/dashboard/projects/'+project.id) %>"><strong><%= project.title %></strong><span><%= project.needs_review_count %> need review →</span></a></li><% }) %></ul><% } %></section><section class="dash-panel outcome-panel"><p class="overline">READY TO PICK UP</p><h2><%= readyJobs.length %> recent <%= readyJobs.length===1?'result':'results' %></h2><% if(!readyJobs.length) { %><p>Finished background work will appear here with a direct path to its result.</p><a class="panel-link" href="<%= brainLink('/dashboard/jobs/new') %>">Give Brain a task →</a><% } else { %><ul><% readyJobs.forEach(job=>{ %><li><a href="<%= brainLink('/dashboard/jobs/'+job.id) %>"><strong><%= job.title %></strong><span><%= job.state==='partial'?'Partial result':'Finished' %> · <%= relativeTime(job.finished_at) %> →</span></a></li><% }) %></ul><% } %></section></div>
<section class="living-projects-preview"><div class="section-title"><div><p class="overline">THE GOAL SURVIVES THE CHANGE OF VOICE</p><h2>Your living projects.</h2></div><a href="<%= brainLink('/dashboard/projects') %>">All projects →</a></div><% if(!projects.length) { %><div class="dash-panel project-welcome compact-project-welcome"><div><h2>A plan that stays together.</h2><p>Keep constraints, decisions, questions, and work in one versioned place. See the source of each change and who last retrieved the plan.</p><a class="dash-button lime" href="<%= brainLink('/dashboard/projects/new') %>">Start your first project →</a></div><div class="project-demo-flow" aria-label="A project records constraints, connects dependent work, and flags changes for review"><span>A real constraint</span><b aria-hidden="true">→</b><span>Work that depends on it</span><b aria-hidden="true">→</b><span>A clear review request</span></div></div><% } else { %><div class="project-grid"><% projects.slice(0,3).forEach(project=>{ %><a class="dash-panel project-card" href="<%= brainLink('/dashboard/projects/'+project.id) %>"><div class="memory-card-top"><span class="kind-badge">Version <%= project.version %></span><span>↗</span></div><h2><%= project.title %></h2><p><%= project.goal||project.summary %></p><% if(project.needs_review_count) { %><strong class="review-notice"><%= project.needs_review_count %> <%= project.needs_review_count===1?'item needs':'items need' %> review</strong><% } %><small>Last changed <%= relativeTime(project.updated_at) %></small></a><% }) %></div><% } %></section>
<nav class="collection-navigation" aria-label="Saved records"><% [['notes','Notes'],['facts','Shared facts'],['snapshots','Snapshots'],['handoffs','Handoffs']].forEach(([type,label])=>{ %><a href="<%= brainLink('/dashboard/memory',{type}) %>"><strong><%= formatNumber(counts[type]) %></strong><span><%= label %></span><b aria-hidden="true">↗</b></a><% }) %></nav>
<section class="assistant-section"><div class="section-title"><div><p class="overline">DIFFERENT VOICES. SAME PAGE.</p><h2>Your inner circle.</h2></div><a href="/account">Manage connections <span>↗</span></a></div><div class="assistant-grid"><% const displayed=agents.length?agents:['maya','miles','simone','charlie'].map(agent_label=>({agent_label,connections:0,last_used_at:null,clients:[]})); displayed.forEach((agent,index)=>{ %><article class="assistant-card tone-<%= index%4 %>"><div class="assistant-card-top"><span class="assistant-avatar"><%= agent.agent_label.charAt(0).toUpperCase() %></span><span class="connection-state"><i class="<%= agent.connections?'connected':'' %>"></i><%= agent.connections?'Connected':'Not connected' %></span></div><h3><%= agent.agent_label %></h3><p><%= agent.connections?agent.clients.join(' · '):'Ready when you are.' %></p><div class="assistant-meta"><span>Last heard</span><strong><%= relativeTime(agent.last_used_at) %></strong></div><a href="<%= agent.connections?brainLink('/dashboard/memory',{agent:agent.agent_label}):'/docs' %>"><%= agent.connections?'Explore memories':'Connect assistant' %><span>↗</span></a></article><% }) %></div></section>
<div class="lower-grid"><section class="dash-panel recent-memory"><div class="panel-heading"><div><p class="overline">KEEP WHAT MATTERS</p><h2>Fresh in your mind.</h2></div><a href="<%= brainLink('/dashboard/memory') %>" class="panel-link">View all ↗</a></div><% if(!recent.length) { %><div class="dash-empty compact"><span class="empty-glyph">◇</span><h3>Make room for the meaningful.</h3><p>A name, an idea, a detail you don’t want to ask twice. Your first memory starts here.</p><a href="<%= brainLink('/dashboard/capture') %>" class="dash-button outline">Save something worth keeping ↗</a></div><% } else { %><div class="memory-list"><% recent.forEach(item=>{ %><a class="memory-row" href="<%= brainLink('/dashboard/memory/'+item.collection+'/'+item.id) %>"><span class="memory-kind-icon kind-<%= item.collection %>"><%= {notes:'▤',facts:'◇',snapshots:'◫',handoffs:'↗'}[item.collection] %></span><div><strong><%= item.title %></strong><p><%= item.preview %></p><small><%= item.agent %> <span>·</span> <%= relativeTime(item.created_at) %></small></div><span class="row-arrow">↗</span></a><% }) %></div><% } %></section><section class="dash-panel recent-jobs"><div class="panel-heading"><div><p class="overline">WHILE LIFE GOES ON</p><h2>Work in the background.</h2></div><a href="<%= brainLink('/dashboard/jobs') %>" class="panel-link">View all ↗</a></div><% if(!jobs.length) { %><div class="dash-empty compact"><span class="empty-glyph violet-text">↗</span><h3>Give a thought some room.</h3><p>Research a question. Compare a few options. Leave a task here and come back to the result.</p><a class="dash-button outline" href="<%= brainLink('/dashboard/jobs/new') %>">Start a task ↗</a></div><% } else { %><div class="job-list"><% jobs.forEach(job=>{ %><a href="<%= brainLink('/dashboard/jobs/'+job.id) %>" class="job-row"><span class="job-state-dot state-<%= job.state %>"></span><div><strong><%= job.title||job.task.slice(0,90) %></strong><small><%= job.requested_by_agent %> <span>·</span> <%= relativeTime(job.created_at) %></small></div><span class="state-pill state-<%= job.state %>"><%= job.state %></span></a><% }) %></div><% } %></section></div>
<div class="lower-grid"><section class="dash-panel timeline-panel"><div class="panel-heading"><div><p class="overline">A THREAD THROUGH IT ALL</p><h2>What’s been happening.</h2></div><span class="tiny-pill">ACTIVITY</span></div><% if(!activity.length) { %><div class="quiet-empty"><span>○</span><p>No activity yet. The next thing you save will start your story here.</p></div><% } else { %><ol class="activity-timeline"><% activity.forEach(item=>{ %><li><span class="timeline-dot"></span><div><strong><%= item.actor_agent %></strong> <%= activityLabel(item.kind) %><time datetime="<%= new Date(item.created_at).toISOString() %>"><%= relativeTime(item.created_at) %></time></div></li><% }) %></ol><% } %></section><section class="dash-panel overnight-panel"><div class="panel-heading"><div><p class="overline">A LITTLE MORE PERSPECTIVE</p><h2>After hours.</h2></div><span class="night-symbol" aria-hidden="true">✧</span></div><% if(!insights.length) { %><p class="overnight-copy">Some things become clearer with a little distance.</p><p class="muted-copy">After an active day, Brain can revisit what you’ve shared, check its interpretations, and show what changed. Your first overnight update will appear here.</p><a class="panel-link" href="<%= brainLink('/dashboard/insights') %>">Explore overnight insights ↗</a><% } else { %><div class="insight-mini-list"><% insights.forEach(item=>{ %><a href="<%= brainLink('/dashboard/memory/snapshots/'+item.id) %>"><span class="kind-badge"><%= item.kind %></span><strong><%= item.title %></strong><small><%= formatDate(item.created_at) %></small></a><% }) %></div><% } %></section></div><details class="record-history"><summary>Saved record totals & activity</summary><div class="stats-grid"><article class="stat-card"><div><span>Saved records</span><i class="stat-symbol lime-text" aria-hidden="true">◇</i></div><strong><%= formatNumber(total) %></strong><p><%= formatNumber(counts.facts) %> facts <span>·</span> <%= formatNumber(counts.notes) %> notes</p></article><article class="stat-card"><div><span>Connected voices</span><i class="stat-symbol violet-text" aria-hidden="true">◉</i></div><strong><%= agents.length %><small> assistants</small></strong><p><%= agents.length?'Sharing one brain':'Connect your first assistant' %></p></article><article class="stat-card"><div><span>Tasks in flight</span><i class="stat-symbol coral-text" aria-hidden="true">↗</i></div><strong><%= jobStats.pending %><small> active</small></strong><p><%= formatNumber(jobStats.finished) %> completed or partial results</p></article><article class="stat-card"><div><span>Brain check-ins</span><i class="stat-symbol blue-text" aria-hidden="true">⌁</i></div><strong><%= formatNumber(sessions.total) %></strong><p><%= sessions.active %> active · activity shared with Brain</p></article></div>
<section class="dash-panel activity-panel"><div class="panel-heading"><div><p class="overline">THE LAST 14 DAYS</p><h2>Small moments. Lasting memory.</h2></div><span class="chart-icon" aria-hidden="true">▥</span></div><div class="chart-total"><strong><%= formatNumber(activityTotal) %></strong><span>actions saved</span></div><div class="activity-chart" role="img" aria-label="<%= activityTotal %> actions over the last 14 days"><% days.forEach((day,index)=>{ %><div class="chart-column"><span class="chart-bar <%= day.count?'has-value':'' %> bar-<%= Math.round(day.count/activityMax*20) %>" title="<%= day.label %>: <%= day.count %> actions"></span><span class="chart-day"><%= index%3===0?day.label.split(' ')[1]:'' %></span></div><% }) %></div><table class="sr-only"><caption>Actions saved each day</caption><thead><tr><th scope="col">Date</th><th scope="col">Actions</th></tr></thead><tbody><% days.forEach(day=>{ %><tr><th scope="row"><%= day.label %></th><td><%= day.count %></td></tr><% }) %></tbody></table><div class="chart-caption"><span><%= days[0].label %></span><span><%= days[13].label %></span></div><div class="usage-inline"><div><span>Today’s thinking allowance</span><strong><%= formatNumber(tokensToday) %> <small>/ <%= formatNumber(dailyBudget) %> tokens</small></strong></div><a href="<%= brainLink('/dashboard/usage') %>" aria-label="View usage">↗</a></div><progress class="usage-progress" max="<%= dailyBudget %>" value="<%= Math.min(tokensToday,dailyBudget) %>" aria-label="Tokens used today"></progress></section></details><%- include('dash-footer') %>
