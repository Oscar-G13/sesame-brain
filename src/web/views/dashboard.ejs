<%- include('dash-header') %><div class="dashboard-heading"><div><p class="overline"><span></span> YOUR PERSONAL INTELLIGENCE</p><h1><%= total?'A mind in motion.':'Room for your next idea.' %></h1><p class="heading-description"><%= total?'Everything your assistants remember. Everything moving forward.':'A fresh start. Your assistants are ready to build something worth remembering.' %></p></div><div class="heading-actions"><a class="dash-button outline" href="<%= brainLink('/dashboard/think') %>">Think with Brain ✳</a><a class="dash-button lime" href="<%= brainLink('/dashboard/capture') %>"><span aria-hidden="true">+</span> Add a memory</a></div></div>
<div class="stats-grid"><article class="stat-card"><div><span>Saved memories</span><i class="stat-symbol lime-text" aria-hidden="true">◇</i></div><strong><%= formatNumber(total) %></strong><p><%= formatNumber(counts.facts) %> facts <span>·</span> <%= formatNumber(counts.notes) %> notes</p></article><article class="stat-card"><div><span>Connected voices</span><i class="stat-symbol violet-text" aria-hidden="true">◉</i></div><strong><%= agents.length %><small> assistants</small></strong><p><%= agents.length?'Sharing one brain':'Connect your first assistant' %></p></article><article class="stat-card"><div><span>Tasks in flight</span><i class="stat-symbol coral-text" aria-hidden="true">↗</i></div><strong><%= jobStats.pending %><small> active</small></strong><p><%= formatNumber(jobStats.finished) %> completed or partial results</p></article><article class="stat-card"><div><span>Conversations</span><i class="stat-symbol blue-text" aria-hidden="true">⌁</i></div><strong><%= formatNumber(sessions.total) %></strong><p><%= sessions.active %> active in the last 30 minutes</p></article></div>
<div class="overview-grid"><section class="dash-panel memory-map-panel"><div class="panel-heading"><div><p class="overline">THE BIG PICTURE</p><h2>Your memory, connected.</h2></div><a class="panel-arrow" href="<%= brainLink('/dashboard/memory') %>" aria-label="Browse all memories">↗</a></div><div class="memory-orbit"><svg viewBox="0 0 600 360" aria-hidden="true"><defs><radialGradient id="orb-glow"><stop offset="0" stop-color="#d9ff65" stop-opacity=".2"/><stop offset="1" stop-color="#d9ff65" stop-opacity="0"/></radialGradient></defs><circle cx="300" cy="180" r="160" fill="url(#orb-glow)"/><ellipse cx="300" cy="180" rx="223" ry="120" class="orbit-ring"/><ellipse cx="300" cy="180" rx="155" ry="76" class="orbit-ring inner-ring"/><path d="M155 80 Q300 180 446 80 M155 280 Q300 180 446 280" class="orbit-path"/><circle cx="300" cy="180" r="66" class="orbit-core"/><circle cx="300" cy="180" r="77" class="orbit-core-ring"/><circle cx="91" cy="139" r="3" fill="#d9ff65"/><circle cx="510" cy="222" r="3" fill="#b8a1ff"/><circle cx="366" cy="66" r="2" fill="#ffaf9a"/></svg><div class="orbit-center"><span class="orbit-brain">b</span><strong><%= formatNumber(total) %></strong><small>MEMORIES</small></div><a class="memory-node node-notes" href="<%= brainLink('/dashboard/memory',{type:'notes'}) %>"><span class="node-icon lime-text">▤</span><div><strong>Notes</strong><small><%= formatNumber(counts.notes) %> saved</small></div></a><a class="memory-node node-facts" href="<%= brainLink('/dashboard/memory',{type:'facts'}) %>"><span class="node-icon violet-text">◇</span><div><strong>Shared facts</strong><small><%= formatNumber(counts.facts) %> remembered</small></div></a><a class="memory-node node-snapshots" href="<%= brainLink('/dashboard/memory',{type:'snapshots'}) %>"><span class="node-icon coral-text">◫</span><div><strong>Snapshots</strong><small><%= formatNumber(counts.snapshots) %> saved</small></div></a><a class="memory-node node-handoffs" href="<%= brainLink('/dashboard/memory',{type:'handoffs'}) %>"><span class="node-icon blue-text">↗</span><div><strong>Handoffs</strong><small><%= formatNumber(counts.handoffs) %> shared</small></div></a></div><div class="panel-footnote"><span class="status-dot"></span><%= total?'A shared picture, built one conversation at a time.':'Nothing saved yet. Start a conversation or add your first memory.' %></div></section>
<section class="dash-panel activity-panel"><div class="panel-heading"><div><p class="overline">THE LAST 14 DAYS</p><h2>Small moments. Lasting memory.</h2></div><span class="chart-icon" aria-hidden="true">▥</span></div><div class="chart-total"><strong><%= formatNumber(activityTotal) %></strong><span>actions saved</span></div><div class="activity-chart" role="img" aria-label="<%= activityTotal %> actions over the last 14 days"><% days.forEach((day,index)=>{ %><div class="chart-column"><span class="chart-bar <%= day.count?'has-value':'' %> bar-<%= Math.round(day.count/activityMax*20) %>" title="<%= day.label %>: <%= day.count %> actions"></span><span class="chart-day"><%= index%3===0?day.label.split(' ')[1]:'' %></span></div><% }) %></div><table class="sr-only"><caption>Actions saved each day</caption><thead><tr><th scope="col">Date</th><th scope="col">Actions</th></tr></thead><tbody><% days.forEach(day=>{ %><tr><th scope="row"><%= day.label %></th><td><%= day.count %></td></tr><% }) %></tbody></table><div class="chart-caption"><span><%= days[0].label %></span><span><%= days[13].label %></span></div><div class="usage-inline"><div><span>Today’s thinking allowance</span><strong><%= formatNumber(tokensToday) %> <small>/ <%= formatNumber(dailyBudget) %> tokens</small></strong></div><a href="<%= brainLink('/dashboard/usage') %>" aria-label="View usage">↗</a></div><progress class="usage-progress" max="<%= dailyBudget %>" value="<%= Math.min(tokensToday,dailyBudget) %>" aria-label="Tokens used today"></progress></section></div>
<section class="assistant-section"><div class="section-title"><div><p class="overline">DIFFERENT VOICES. SAME PAGE.</p><h2>Your inner circle.</h2></div><a href="/account">Manage connections <span>↗</span></a></div><div class="assistant-grid"><% const displayed=agents.length?agents:['maya','miles','simone','charlie'].map(agent_label=>({agent_label,connections:0,last_used_at:null,clients:[]})); displayed.forEach((agent,index)=>{ %><article class="assistant-card tone-<%= index%4 %>"><div class="assistant-card-top"><span class="assistant-avatar"><%= agent.agent_label.charAt(0).toUpperCase() %></span><span class="connection-state"><i class="<%= agent.connections?'connected':'' %>"></i><%= agent.connections?'Connected':'Not connected' %></span></div><h3><%= agent.agent_label %></h3><p><%= agent.connections?agent.clients.join(' · '):'Ready when you are.' %></p><div class="assistant-meta"><span>Last heard</span><strong><%= relativeTime(agent.last_used_at) %></strong></div><a href="<%= agent.connections?brainLink('/dashboard/memory',{agent:agent.agent_label}):'/docs' %>"><%= agent.connections?'Explore memories':'Connect assistant' %><span>↗</span></a></article><% }) %></div></section>
<div class="lower-grid"><section class="dash-panel recent-memory"><div class="panel-heading"><div><p class="overline">KEEP WHAT MATTERS</p><h2>Fresh in your mind.</h2></div><a href="<%= brainLink('/dashboard/memory') %>" class="panel-link">View all ↗</a></div><% if(!recent.length) { %><div class="dash-empty compact"><span class="empty-glyph">◇</span><h3>Make room for the meaningful.</h3><p>A name, an idea, a detail you don’t want to ask twice. Your first memory starts here.</p><a href="<%= brainLink('/dashboard/capture') %>" class="dash-button outline">Save something worth keeping ↗</a></div><% } else { %><div class="memory-list"><% recent.forEach(item=>{ %><a class="memory-row" href="<%= brainLink('/dashboard/memory/'+item.collection+'/'+item.id) %>"><span class="memory-kind-icon kind-<%= item.collection %>"><%= {notes:'▤',facts:'◇',snapshots:'◫',handoffs:'↗'}[item.collection] %></span><div><strong><%= item.title %></strong><p><%= item.preview %></p><small><%= item.agent %> <span>·</span> <%= relativeTime(item.created_at) %></small></div><span class="row-arrow">↗</span></a><% }) %></div><% } %></section><section class="dash-panel recent-jobs"><div class="panel-heading"><div><p class="overline">WHILE LIFE GOES ON</p><h2>Work in the background.</h2></div><a href="<%= brainLink('/dashboard/jobs') %>" class="panel-link">View all ↗</a></div><% if(!jobs.length) { %><div class="dash-empty compact"><span class="empty-glyph violet-text">↗</span><h3>Give a thought some room.</h3><p>Research a question. Compare a few options. Leave a task here and come back to the result.</p><a class="dash-button outline" href="<%= brainLink('/dashboard/jobs/new') %>">Start a task ↗</a></div><% } else { %><div class="job-list"><% jobs.forEach(job=>{ %><a href="<%= brainLink('/dashboard/jobs/'+job.id) %>" class="job-row"><span class="job-state-dot state-<%= job.state %>"></span><div><strong><%= job.title||job.task.slice(0,90) %></strong><small><%= job.requested_by_agent %> <span>·</span> <%= relativeTime(job.created_at) %></small></div><span class="state-pill state-<%= job.state %>"><%= job.state %></span></a><% }) %></div><% } %></section></div>
<div class="lower-grid"><section class="dash-panel timeline-panel"><div class="panel-heading"><div><p class="overline">A THREAD THROUGH IT ALL</p><h2>What’s been happening.</h2></div><span class="tiny-pill">ACTIVITY</span></div><% if(!activity.length) { %><div class="quiet-empty"><span>○</span><p>No activity yet. The next thing you save will start your story here.</p></div><% } else { %><ol class="activity-timeline"><% activity.forEach(item=>{ %><li><span class="timeline-dot"></span><div><strong><%= item.actor_agent %></strong> <%= activityLabel(item.kind) %><time datetime="<%= new Date(item.created_at).toISOString() %>"><%= relativeTime(item.created_at) %></time></div></li><% }) %></ol><% } %></section><section class="dash-panel overnight-panel"><div class="panel-heading"><div><p class="overline">A LITTLE MORE PERSPECTIVE</p><h2>After hours.</h2></div><span class="night-symbol" aria-hidden="true">✧</span></div><% if(!insights.length) { %><p class="overnight-copy">Some things become clearer with a little distance.</p><p class="muted-copy">After an active day, Brain can revisit what you’ve shared, check its interpretations, and show what changed. Your first overnight update will appear here.</p><a class="panel-link" href="<%= brainLink('/dashboard/insights') %>">Explore overnight insights ↗</a><% } else { %><div class="insight-mini-list"><% insights.forEach(item=>{ %><a href="<%= brainLink('/dashboard/memory/snapshots/'+item.id) %>"><span class="kind-badge"><%= item.kind %></span><strong><%= item.title %></strong><small><%= formatDate(item.created_at) %></small></a><% }) %></div><% } %></section></div><%- include('dash-footer') %>
