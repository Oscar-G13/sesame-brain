<%- include('dash-header') %><a class="dash-back" href="<%= brainLink('/dashboard/jobs') %>">← All work</a><div class="detail-heading"><span class="state-pill state-<%= job.state %>"><%= job.state %></span><h1><%= job.title||job.task.slice(0,90) %></h1><p>Requested by <strong><%= job.requested_by_agent %></strong> <span>·</span> <%= formatDate(job.created_at) %> Pacific</p></div><div class="job-detail-grid"><article class="dash-panel detail-body"><p class="overline">THE REQUEST</p><pre class="memory-content"><%= job.task %></pre><% if(job.result_summary) { %><div class="detail-extra"><h2>The result</h2><pre class="memory-content"><%= job.result_summary %></pre></div><% } else if(['queued','running'].includes(job.state)) { %><div class="working-note"><span class="working-orb"></span><p><%= job.state==='queued'?'Your task is waiting its turn.':'Brain is working on this. Return later to read the result.' %></p></div><% } %><% if(job.error) { %><div class="dash-notice warning"><%= job.error %></div><% } %><% if(job.result_note_id) { %><a class="dash-button lime" href="<%= brainLink('/dashboard/memory/notes/'+job.result_note_id) %>">Read the full result ↗</a><% } %></article><aside class="dash-panel job-facts"><h2>The details</h2><dl><div><dt>Status</dt><dd><%= job.state %></dd></div><div><dt>Started</dt><dd><%= formatDate(job.started_at) %></dd></div><div><dt>Finished</dt><dd><%= formatDate(job.finished_at) %></dd></div><div><dt>Tokens used</dt><dd><%= formatNumber(job.tokens_used) %></dd></div><div><dt>Delivery</dt><dd><%= job.deliver==='brain+email'?'Brain + email':'In your brain' %></dd></div></dl><% if(['queued','running'].includes(job.state)) { %><form method="post" action="<%= brainLink('/dashboard/jobs/'+job.id+'/cancel') %>" class="cancel-job-form" data-pending-label="Stopping…"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="dash-button cancel-work" type="submit">Stop this task</button><p>Stop future work on this task.</p></form><% } %><% if(job.handoff_id) { %><a class="panel-link" href="<%= brainLink('/dashboard/memory/handoffs/'+job.handoff_id) %>">View the handoff ↗</a><% } %></aside></div><%- include('dash-footer') %>
