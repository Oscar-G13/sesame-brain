<%- include('dash-header') %><a class="dash-back" href="<%= brainLink('/dashboard/memory') %>">← All memories</a><div class="detail-heading"><span class="kind-badge badge-<%= collection %>"><%= collection==='facts'?'Shared fact':collection==='snapshots'?item.kind:collection==='handoffs'?'Handoff':'Note' %></span><h1><%= heading %></h1><p><strong><%= item.from_agent||item.updated_by||item.agent_label %></strong> <span>·</span> <%= formatDate(item.created_at||item.updated_at) %> Pacific</p></div><article class="dash-panel detail-body"><pre class="memory-content"><%= content %></pre><% if(collection==='handoffs') { %><div class="detail-extra"><span class="state-pill state-<%= item.status==='completed'?'done':item.status==='accepted'?'running':'queued' %>"><%= item.status %></span><p>For <strong><%= item.to_agent %></strong></p><% if(item.next_steps) { %><h2>Next steps</h2><pre class="memory-content"><%= item.next_steps %></pre><% } %><% if(item.summary) { %><h2>Completion summary</h2><pre class="memory-content"><%= item.summary %></pre><% } %></div><% } %><% if(item.tags&&item.tags.length) { %><div class="tag-list"><% item.tags.forEach(tag=>{ %><span><%= tag %></span><% }) %></div><% } %></article><%- include('dash-footer') %>
