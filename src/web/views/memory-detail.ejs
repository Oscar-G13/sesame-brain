<%- include('dash-header') %><a class="dash-back" href="<%= brainLink('/dashboard/memory') %>">← All memories</a><div class="detail-heading"><span class="kind-badge badge-<%= collection %>"><%= collection==='facts'?'Shared fact':collection==='snapshots'?item.kind:collection==='handoffs'?'Handoff':'Note' %></span><h1><%= heading %></h1><p><strong><%= item.from_agent||item.updated_by||item.agent_label %></strong> <span>·</span> <%= formatDate(item.created_at||item.updated_at) %> Pacific</p></div><% if(item.visibility&&item.visibility!=='shared') { %><p class="visibility-boundary"><strong><%= item.visibility==='owner_only'?'Only you can read this record':'Restricted sharing' %></strong><%= item.visibility==='owner_only'?'This record is excluded from assistant tools.':'Only the assistants selected for this record can read it.' %></p><% } %><article class="dash-panel detail-body"><% if(typeof insight!=='undefined'&&insight) { %><section class="insight-summary"><p class="overline">THE HUMAN VIEW</p><h2><%= insight.title %></h2><p><%= insight.summary %></p><p class="record-boundary">An interpretation of saved material, never a diagnosis or a full conversation transcript.</p></section><% insight.sections.forEach(section=>{ %><section class="insight-section"><h2><%= section.title %></h2><% if(section.title==='Evidence recorded') { %><p class="record-boundary">These entries are the reflection’s evidence summaries, not a transcript.</p><% } %><% section.entries.forEach(entry=>{ %><article><% if(entry.label) { %><h3><%= entry.label %></h3><% } %><div class="evidence-labels"><% if(entry.evidence) { %><span><%= entry.evidence %></span><% } %><% if(entry.confidence) { %><span>Confidence: <%= entry.confidence %></span><% } %><% if(entry.date) { %><time><%= entry.date %></time><% } %></div><p><%= entry.text %></p><% if(entry.alternatives&&entry.alternatives.length) { %><details><summary>Other explanations to consider</summary><ul><% entry.alternatives.forEach(value=>{ %><li><%= value %></li><% }) %></ul></details><% } %></article><% }) %></section><% }) %><details class="raw-record"><summary>View the original structured record</summary><pre class="memory-content"><%= content %></pre></details><% } else { %><pre class="memory-content"><%= content %></pre><% } %><% if(collection==='handoffs') { %><div class="detail-extra"><span class="state-pill state-<%= item.status==='completed'?'done':item.status==='accepted'?'running':'queued' %>"><%= item.status %></span><p>For <strong><%= item.to_agent %></strong></p><% if(item.next_steps) { %><h2>Next steps</h2><pre class="memory-content"><%= item.next_steps %></pre><% } %><% if(item.summary) { %><h2>Completion summary</h2><pre class="memory-content"><%= item.summary %></pre><% } %></div><% } %><% if(item.tags&&item.tags.length) { %><div class="tag-list"><% item.tags.forEach(tag=>{ %><span><%= tag %></span><% }) %></div><% } %></article><% if(collection==='facts') { %><section class="dash-panel fact-correction"><h2>Correct the record</h2><p>A correction keeps the earlier version in its history and clearly marks this version as confirmed by you.</p><form method="post" action="<%= brainLink('/dashboard/memory/facts/'+item.id+'/correct') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="correct-value">The accurate detail</label><textarea id="correct-value" name="value" maxlength="8000" required><%= item.value %></textarea><label for="correct-reason">What changed? <small>Optional</small></label><input id="correct-reason" name="reason" maxlength="2000"><label class="check"><input type="checkbox" name="confirm" value="yes" required><span>I confirm this correction.</span></label><button class="dash-button lime" type="submit">Save confirmed correction</button></form></section><section class="dash-panel fact-history"><h2>How this fact changed</h2><% if(!history.length) { %><p>No earlier revisions are recorded.</p><% } %><ol><% history.forEach(revision=>{ %><li><div class="evidence-labels"><span><%= revision.actor_agent %></span><time><%= formatDate(revision.created_at) %></time><span><%= (revision.confirmation||'unconfirmed').replaceAll('_',' ') %></span></div><p><%= revision.value %></p><% if(revision.reason) { %><small><%= revision.reason %></small><% } %></li><% }) %></ol></section><% } %><%- include('dash-footer') %>
