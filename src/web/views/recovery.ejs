<%- include('header') %><main class="narrow"><a class="back-link" href="/account">← Account settings</a><div class="eyebrow">A WAY BACK IN</div><h1>Recovery codes.</h1><p class="lede">A recovery code can reset your password if you forget it. Each code works once.</p><% if(error) { %><p class="message error" role="alert"><%= error %></p><% } %><% if(notice) { %><p class="message" role="status"><%= notice %></p><% } %><% if(codes&&codes.length) { %><section class="recovery-codes"><h2>Save these codes now.</h2><p>These codes are shown only this once. Keep them somewhere you can find without signing in to Brain.</p><ul><% codes.forEach(code=>{ %><li><code><%= code %></code></li><% }) %></ul></section><% } else { %><p><strong><%= recoveryAvailable %></strong> unused recovery <%= recoveryAvailable===1?'code':'codes' %> available.</p><% } %><form method="post" action="/account/recovery" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="current-password">Current password</label><input id="current-password" type="password" name="current_password" autocomplete="current-password" required><p class="field-help">Generating a new set replaces all previous recovery codes.</p><button class="primary full" type="submit">Generate new codes</button></form></main><%- include('footer') %>
