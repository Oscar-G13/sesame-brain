<%- include('header') %><main class="narrow"><a class="back-link" href="/account">← Keep my account</a><div class="eyebrow">PERMANENT DELETION</div><h1>Leave no memory.</h1><p class="lede">Your account, notes, handoffs, facts, snapshots, and all assistant connections will be deleted immediately.</p><p>Download an <a href="/account/export">export</a> first if you want a copy. Same-host recovery backups expire within 14 days; they are not searchable through Brain.</p><% if(error) { %><p class="message error" role="alert"><%= error %></p><% } %><form class="form-card" method="post" action="/account/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="confirm">Type DELETE to confirm</label><input id="confirm" name="confirm" autocomplete="off" pattern="DELETE" required><button class="destructive full" type="submit">Delete account and all data</button><a class="secondary button full" href="/account">Keep my account</a></form></main><%- include('footer') %>
