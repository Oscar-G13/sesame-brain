<%- include('dash-header') %><div class="dashboard-heading"><div><p class="overline">A PLACE FOR WHAT MATTERS</p><h1>Your memory.</h1><p class="heading-description">Notes, facts, snapshots, and handoffs. A little less to carry in your head.</p></div><a class="dash-button lime" href="<%= brainLink('/dashboard/capture') %>">+ Add a memory</a></div><form class="memory-filters" method="get" action="/dashboard/memory"><input type="hidden" name="brain" value="<%= brain.id %>"><label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search memories</span><input type="search" name="q" value="<%= q %>" maxlength="160" placeholder="A thought, a name, a detail…"></label><label><span class="sr-only">Collection</span><select name="type"><% [['all','All memories'],['notes','Notes'],['facts','Shared facts'],['snapshots','Snapshots'],['handoffs','Handoffs']].forEach(([value,label])=>{ %><option value="<%= value %>" <%- type===value?'selected':'' %>><%= label %></option><% }) %></select></label><label><span class="sr-only">Assistant</span><select name="agent"><option value="">Every assistant</option><% agents.forEach(item=>{ %><option value="<%= item.agent %>" <%- agent===item.agent?'selected':'' %>><%= item.agent %></option><% }) %></select></label><button class="dash-button outline" type="submit">Search</button></form><div class="results-line"><span><strong><%= formatNumber(count) %></strong> <%= count===1?'memory':'memories' %><%= q?' found':'' %></span><% if(q||type!=='all'||agent) { %><a href="<%= brainLink('/dashboard/memory') %>">Clear filters ×</a><% } %></div><% if(!rows.length) { %><section class="dash-panel dash-empty large"><span class="empty-glyph">◇</span><h2><%= q||type!=='all'||agent?'Nothing here matches.':'A fresh page, waiting for you.' %></h2><p><%= q||type!=='all'||agent?'Try another phrase or a wider filter.':'The details your assistants save will gather here. You can add the first one yourself.' %></p><a class="dash-button lime" href="<%= brainLink('/dashboard/capture') %>">Add your first memory ↗</a></section><% } else { %><div class="memory-card-grid"><% rows.forEach(item=>{ %><a class="memory-card dash-panel" href="<%= brainLink('/dashboard/memory/'+item.collection+'/'+item.id) %>"><div class="memory-card-top"><span class="kind-badge badge-<%= item.collection %>"><%= item.collection==='facts'?'Shared fact':item.collection==='snapshots'?item.kind:item.collection==='handoffs'?'Handoff':'Note' %></span><span>↗</span></div><h2><%= item.title %></h2><p><%= item.preview %></p><div class="memory-card-meta"><strong><%= item.agent %></strong><time datetime="<%= new Date(item.created_at).toISOString() %>"><%= relativeTime(item.created_at) %></time></div></a><% }) %></div><% } %><% if(pages>1) { %><nav class="pagination" aria-label="Memory pages"><% if(page>1) { %><a class="dash-button outline" href="<%= brainLink('/dashboard/memory',{q,type,agent,page:String(page-1)}) %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if(page<pages) { %><a class="dash-button outline" href="<%= brainLink('/dashboard/memory',{q,type,agent,page:String(page+1)}) %>">Next →</a><% } %></nav><% } %><%- include('dash-footer') %>
