<%- include('header') %><main class="narrow"><a class="back-link" href="/account">← Your account</a><h1>Change password.</h1><p class="lede">Other web sessions will end. Assistant connections stay connected.</p><% if(error) { %><p class="message error" role="alert"><%= error %></p><% } %><form method="post" action="/account/password" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="current-password">Current password</label><input id="current-password" type="password" name="current_password" maxlength="1024" autocomplete="current-password" required><label for="new-password">New password</label><input id="new-password" type="password" name="password" minlength="10" maxlength="1024" autocomplete="new-password" required><p class="field-help">At least 10 characters. Common passwords are blocked.</p><button class="primary full" type="submit">Update password →</button></form></main><%- include('footer') %>
