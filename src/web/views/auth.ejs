<%- include('header') %>
<main class="narrow"><a class="back-link" href="/">← Back to Brain</a><div class="eyebrow">YOUR OWN SHARED SPACE</div><h1><%= mode === 'signup' ? 'Create your brain.' : 'Welcome back.' %></h1><p class="lede"><%= mode === 'signup' ? 'One account. Every assistant on the same page.' : 'Sign in to connect an assistant or manage your memory.' %></p>
<% if(notice) { %><p role="status" class="message"><%= notice %></p><% } %><% if(error) { %><p role="alert" class="message error"><%= error %></p><% } %>
<form method="post" action="/<%= mode %>" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><label for="email">Email address</label><input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" maxlength="254" required><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="<%= mode === 'signup' ? 'new-password' : 'current-password' %>" <%- mode === 'signup' ? 'minlength="10"' : '' %> maxlength="1024" required>
<% if(mode === 'signup') { %><p class="field-help">At least 10 characters. Common passwords are blocked.</p><label class="check"><input type="checkbox" name="age_confirm" value="yes" required><span>I am 18 or older. I have read the <a href="/privacy">privacy page</a>.</span></label><% } %>
<button class="primary full" type="submit"><%= mode === 'signup' ? 'Create account' : 'Sign in' %> <span aria-hidden="true">→</span></button></form><% if(mode==='login') { %><p class="auth-switch"><a href="/recover">Use a recovery code</a></p><% } %><p class="auth-switch"><%= mode === 'signup' ? 'Already have a brain?' : 'New here?' %> <a href="/<%= mode === 'signup' ? 'login' : 'signup' %>?next=<%= encodeURIComponent(next) %>"><%= mode === 'signup' ? 'Sign in' : 'Create an account' %></a></p><p class="small muted">No email verification is required. Save recovery codes in your account settings.</p></main><%- include('footer') %>
