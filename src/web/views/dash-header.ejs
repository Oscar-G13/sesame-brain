<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#090b0e"><title><%= title %> · <%= config.name %></title><link rel="stylesheet" href="/assets/style.css"><script src="/assets/app.js" defer></script></head><body class="dashboard-body"><a class="skip-link" href="#main">Skip to content</a><div class="dashboard-shell"><aside class="rail"><a class="dash-brand" href="<%= brainLink('/dashboard') %>"><span class="brand-mark">b</span><strong><%= config.name %><small>YOUR SHARED MIND</small></strong><span class="version">03</span></a><div class="rail-label">WORKSPACE</div><nav class="dash-nav" aria-label="Dashboard"><% const nav=[['overview','/dashboard','Overview','◉'],['projects','/dashboard/projects','Living projects','↗'],['think','/dashboard/think','Think with Brain','✳'],['memory','/dashboard/memory','Memory','◇'],['jobs','/dashboard/jobs','Background work','↗'],['files','/dashboard/files','Your files','▤'],['insights','/dashboard/insights','Overnight insights','✧'],['usage','/dashboard/usage','Usage','▥']]; nav.forEach(([key,path,label,symbol])=>{ %><a href="<%= brainLink(path) %>" <%- section===key?'aria-current="page"':'' %>><span aria-hidden="true"><%= symbol %></span><%= label %><% if(key==='overview') { %><i aria-hidden="true"></i><% } %></a><% }) %></nav><details class="mobile-workspace-menu"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Workspace navigation"><% nav.forEach(([key,path,label,symbol])=>{ %><a href="<%= brainLink(path) %>" <%- section===key?'aria-current="page"':'' %>><span aria-hidden="true"><%= symbol %></span><%= label %></a><% }) %><a href="/account">Settings & connections</a></nav></details><div class="rail-bottom"><div class="privacy-note"><span class="mini-lock" aria-hidden="true">⌑</span><strong>Your memory.<br>Your control.</strong><p>One private space for the voices you choose.</p><a href="/privacy">Our privacy promise ↗</a></div><a class="rail-settings" href="/account"><span aria-hidden="true">⚙</span> Settings & connections <span>↗</span></a><div class="profile"><span class="avatar"><%= user.email.charAt(0).toUpperCase() %></span><div><strong>Your account</strong><small><%= user.email %></small></div></div></div></aside><div class="dashboard-stage"><header class="dash-topbar"><div class="workspace-select"><span class="workspace-icon" aria-hidden="true">◇</span><form method="get" action="/dashboard"><label class="sr-only" for="brain-selector">Choose brain</label><select id="brain-selector" name="brain"><% brains.forEach(item=>{ %><option value="<%= item.id %>" <%- item.id===brain.id?'selected':'' %>><%= item.name==='default'?'My brain':item.name %></option><% }) %></select><button type="submit" class="brain-switch" aria-label="Switch brain">→</button></form><span class="private-pill">PRIVATE</span></div><div class="topbar-right"><a class="topbar-search" href="<%= brainLink('/dashboard/memory') %>"><span aria-hidden="true">⌕</span> Search your memory</a><a class="topbar-help" href="/docs" aria-label="Connection guide">?</a><a href="/account" class="topbar-avatar" aria-label="Account settings"><%= user.email.charAt(0).toUpperCase() %></a></div></header><main id="main" class="dashboard-main" tabindex="-1"><% if(typeof aiAccess!=='undefined'&&!aiAccess.approved) { %><div class="access-banner" role="status"><strong>Your shared memory is ready.</strong><span>Your thinking and background-work access is pending account approval.</span></div><% } %><% if(typeof notice!=='undefined' && notice) { %><div class="dash-notice" role="status"><span>✓</span><%= notice %></div><% } %>
