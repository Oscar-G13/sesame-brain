<%- include('header') %>
<main class="account"><a class="back-link" href="/dashboard">← Dashboard</a><div class="eyebrow">YOUR SPACE</div><h1>Account & connections.</h1><p class="lede"><%= user.email %></p><% if(notice) { %><p class="message" role="status"><%= notice %></p><% } %><section><div class="section-heading"><h2>Connected assistants</h2><span class="pill"><%= grants.length %> connected</span></div><% if(!grants.length) { %><div class="empty"><span class="brand-mark">b</span><h3>Ready for the first connection.</h3><p>Add <code><%= config.resource %></code> in your assistant’s app.</p><a class="text-link" href="/docs">Follow the guide →</a></div><% } %><div class="grant-list"><% grants.forEach(grant => { %><article class="grant"><div class="grant-name"><h3><%= grant.agent_label %></h3><span><%= grant.client_name || 'MCP client' %></span></div><dl><div><dt>Connected</dt><dd><%= new Date(grant.created_at).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}) %></dd></div><div><dt>Last used</dt><dd><%= grant.last_used_at ? new Date(grant.last_used_at).toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short',timeZone:'UTC'})+' UTC' : 'Not yet' %></dd></div></dl><div class="grant-actions"><form method="post" action="/account/grants/<%= grant.id %>/rename"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="agent-<%= grant.id %>">Assistant name</label><input id="agent-<%= grant.id %>" name="agent_label" value="<%= grant.agent_label %>" pattern="[a-z0-9-]{1,32}" maxlength="32" required><button class="secondary" type="submit">Rename</button></form><form method="post" action="/account/grants/<%= grant.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet danger" type="submit">Revoke</button></form></div></article><% }) %></div></section><section class="account-controls"><h2>Memory belongs to you.</h2><p>Download your notes, facts, handoffs, snapshots, and connection history in one JSON file.</p><a class="primary button" href="/account/export">Export everything ↓</a></section><section class="settings"><h2>Account settings</h2><a href="/dashboard/clear">Clear brain content <span>→</span></a><a href="/account/password">Change password <span>→</span></a><form method="post" action="/account/signout-everywhere"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="settings-button" type="submit">Sign out everywhere <span>↗</span></button><p class="field-help">Ends web sessions and revokes all assistant connections.</p></form><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="settings-button" type="submit">Sign out of this browser <span>↗</span></button></form><a class="danger" href="/account/delete">Delete account and all data <span>→</span></a></section></main><%- include('footer') %>
