<%- include('dash-header') %><div class="dashboard-heading"><div><p class="overline">SOMETHING TO TAKE WITH YOU</p><h1>Thoughts, made tangible.</h1><p class="heading-description">The files your background work leaves behind. Download a copy and make it yours.</p></div></div><% if(!files.length) { %><section class="dash-panel dash-empty large"><span class="empty-glyph violet-text">▤</span><h2>Good work can leave something behind.</h2><p>When Brain saves a brief, a comparison, or another useful file, you’ll find it here.</p><a href="<%= brainLink('/dashboard/jobs/new') %>" class="dash-button lime">Start a task ↗</a></section><% } else { %><section class="dash-panel workspace-files"><div class="panel-heading"><div><p class="overline">SAVED FOR YOU</p><h2><%= files.length %> <%= files.length===1?'file':'files' %></h2></div><span class="tiny-pill">DOWNLOADS</span></div><div class="file-list"><% files.forEach(file=>{ %><a href="<%= brainLink('/dashboard/files/'+encodeURIComponent(file.name)) %>" class="file-row"><span class="file-symbol" aria-hidden="true">▤</span><div><strong><%= file.name %></strong><small><%= formatNumber(file.bytes) %> bytes <span>·</span> <%= formatDate(file.updated_at) %></small></div><span aria-hidden="true">↓</span><span class="sr-only">Download <%= file.name %></span></a><% }) %></div><p class="file-footnote">Saved files are served as downloads. Open them with the app you choose.</p></section><% } %><%- include('dash-footer') %>
