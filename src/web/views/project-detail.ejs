<%- include('dash-header') %><% const settingsDraft=typeof settingsValues!=='undefined'?settingsValues:{}; %><a class="dash-back" href="<%= brainLink('/dashboard/projects') %>">← All living projects</a><div class="dashboard-heading"><div><p class="overline">A PLAN THAT KEEPS ITS CONTEXT</p><h1 data-live-project-title><%= board.project.title %></h1><p class="heading-description" data-live-project-goal><%= board.project.goal %></p></div><span class="live-project-indicator"><i></i> Updates while you’re here</span></div><% if(error) { %><p class="message error" role="alert"><%= error %></p><% } %><div class="project-live" data-project-version="<%= board.project.version %>" data-project-state-url="<%= brainLink('/dashboard/projects/'+board.project.id+'/state') %>" data-project-ack-url="<%= brainLink('/dashboard/projects/'+board.project.id+'/ack') %>" data-csrf="<%= csrf %>"><div class="project-update-prompt" hidden role="status"><span>A newer version is ready. Your draft is still here.</span><button type="button" class="dash-button outline" data-apply-project-update>Review the update</button></div><div class="board-filters"><label for="project-type-filter">Show sections</label><select id="project-type-filter" data-project-type-filter><option value="all">All saved sections</option><% projectTypes.forEach(type=>{ %><option value="<%= type %>"><%= type.charAt(0).toUpperCase()+type.slice(1) %></option><% }) %></select><label class="check"><input type="checkbox" data-project-review-filter><span>Needs review only</span></label></div><div data-project-canvas><%- include('project-board',{board}) %></div></div><div class="project-editing-grid"><section class="dash-panel compose-panel"><h2>Add to the shared plan</h2><form class="compose-form" method="post" action="<%= brainLink('/dashboard/projects/'+board.project.id+'/items') %>" data-project-draft data-pending-label="Saving…"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= values.request_id||newRequestId() %>"><input type="hidden" name="expected_version" value="<%= board.project.version %>"><label for="item-type">What kind of detail?</label><select id="item-type" name="type"><% projectTypes.forEach(type=>{ %><option value="<%= type %>" <%- values.type===type?'selected':'' %>><%= type.charAt(0).toUpperCase()+type.slice(1) %></option><% }) %></select><label for="item-title">A clear title</label><input id="item-title" name="title" maxlength="200" required value="<%= values.title||'' %>"><label for="item-content">The detail</label><textarea id="item-content" name="content" maxlength="16000" rows="4"><%= values.content||'' %></textarea><label for="item-dependencies">What does this depend on? <small>Optional; choose one or more</small></label><select id="item-dependencies" name="depends_on" multiple size="4"><% board.items.forEach(item=>{ %><option value="<%= item.id %>"><%= item.title %></option><% }) %></select><label class="check"><input type="checkbox" name="confirm" value="yes"><span>I confirm this information. Leave unchecked to save it as a proposal.</span></label><div class="compose-actions"><button type="submit" class="dash-button lime">Add to project</button><button type="button" class="dash-button outline" data-discard-project-draft>Discard draft</button></div></form></section><section class="dash-panel project-help"><p class="overline">TRY IT WITH ANOTHER VOICE</p><h2>Pick up the same project.</h2><p>Ask an assistant: “Open my project <strong><%= board.project.title %></strong> in Brain. What changed, and what needs my decision?”</p><p>A retrieved version is a receipt that the assistant checked Brain. It does not mean its separate native memory has been rewritten.</p><details><summary>Project settings</summary><form class="compose-form" method="post" action="<%= brainLink('/dashboard/projects/'+board.project.id+'/settings') %>" data-project-draft><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= newRequestId() %>"><input type="hidden" name="expected_version" value="<%= board.project.version %>"><label for="settings-title">Name</label><input id="settings-title" name="title" value="<%= settingsDraft.title??board.project.title %>" maxlength="160" required><label for="settings-goal">Goal</label><textarea id="settings-goal" name="goal" maxlength="12000"><%= settingsDraft.goal??board.project.goal %></textarea><label for="settings-status">Status</label><select id="settings-status" name="status"><% ['active','paused','completed','archived'].forEach(status=>{ %><option <%- (settingsDraft.status??board.project.status)===status?'selected':'' %>><%= status %></option><% }) %></select><label for="settings-agents">Allowed assistants <small>Access can only be narrowed here</small></label><input id="settings-agents" name="allowed_agents" value="<%= settingsDraft.allowed_agents??(board.project.allowed_agents||[]).filter(value=>value!=='all').join(', ') %>"><p class="compose-hint">To share reviewed information with more assistants, <a href="<%= brainLink('/dashboard/projects/new') %>">create a new shared project</a>.</p><label for="settings-reason">Why this change?</label><input id="settings-reason" name="reason" maxlength="2000" value="<%= settingsDraft.reason||'' %>" required><button type="submit" class="dash-button outline">Save settings</button></form></details></section></div><%- include('dash-footer') %>