<%- include('dash-header') %><a class="dash-back" href="<%= brainLink('/dashboard/memory') %>">← All memories</a><div class="dashboard-heading"><div><p class="overline">KEEP A LITTLE SOMETHING</p><h1>Worth remembering.</h1><p class="heading-description">Save a note or fact to return to in your next conversation.</p></div></div><section class="dash-panel compose-panel"><% if(error) { %><p role="alert" class="message error"><%= error %></p><% } %><form method="post" action="<%= brainLink('/dashboard/capture') %>" class="compose-form" data-pending-label="Saving…"><input type="hidden" name="_csrf" value="<%= csrf %>"><fieldset class="choice-row"><legend>What kind of memory?</legend><label><input type="radio" name="type" value="note" <%- type==='note'?'checked':'' %>><span><strong>A note</strong><small>A useful thread to pick up later.</small></span></label><label><input type="radio" name="type" value="fact" <%- type==='fact'?'checked':'' %>><span><strong>A shared fact</strong><small>A detail to find and update later.</small></span></label></fieldset><label for="memory-key">Fact name <small>Only needed for a shared fact</small></label><input id="memory-key" name="key" value="<%= key %>" maxlength="128" placeholder="e.g. morning commute"><label for="memory-text">What should your brain remember?</label><textarea id="memory-text" name="text" maxlength="8000" rows="7" placeholder="The detail, thought, or idea worth keeping…" required><%= text %></textarea><p class="compose-hint">Saved as you. Your connected assistants can find it in this brain.</p><div class="compose-actions"><button type="submit" class="dash-button lime">Save memory ↗</button><a href="<%= brainLink('/dashboard/memory') %>" class="dash-button outline">Cancel</a></div></form></section><%- include('dash-footer') %>
