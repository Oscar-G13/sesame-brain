<section class="dash-panel project-version-summary"><div><span class="kind-badge">Version <%= board.project.version %></span><span class="state-pill"><%= board.project.status %></span></div><p><%= board.project.needs_review_count?board.project.needs_review_count+(board.project.needs_review_count===1?' item needs':' items need')+' review after a change. Approving one item does not automatically approve its dependents.':'No dependent items are currently flagged for review.' %></p></section><section class="project-board" data-project-links="<%= JSON.stringify(board.links||[]) %>"><div class="board-explanation"><h2>The live canvas</h2><p>Arrows run from a prerequisite to the item that depends on it. Every card keeps its source and revision.</p></div><div class="project-board-plane"><svg class="project-dependency-lines" aria-hidden="true"><defs><marker id="dependency-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8" fill="currentColor"/></marker></defs><g></g></svg><div class="project-lanes"><% projectTypes.filter(type=>!board.items.length||board.items.some(item=>item.type===type)).forEach(type=>{ const lane=board.items.filter(item=>item.type===type); %><section class="project-lane" data-project-type="<%= type %>"><header><h3><%= type.charAt(0).toUpperCase()+type.slice(1) %><%= type==='milestone'?'s':type==='artifact'?'s':type==='question'?'s':type==='task'?'s':type==='decision'?'s':'s' %></h3><span><%= lane.length %></span></header><% if(!lane.length) { %><p class="lane-empty">Nothing here yet.</p><% } %><% lane.forEach(item=>{ const draft=typeof editItemId!=='undefined'&&editItemId===item.id&&typeof editValues!=='undefined'?editValues:{}; %><article class="project-item <%= item.needs_review?'needs-review':'' %>" id="project-item-<%= item.id %>" data-project-item="<%= item.id %>" data-review-needed="<%= item.needs_review %>" tabindex="-1"><div class="project-item-labels"><span class="state-pill"><%= item.status.replaceAll('_',' ') %></span><% if(item.needs_review) { %><span class="review-badge">Needs review</span><% } %></div><h4><%= item.title %></h4><p class="project-item-content"><%= item.content %></p><% if(item.pending_change) { %><section class="pending-project-change"><strong>Proposed change · <%= item.pending_change.proposed_by %></strong><% if(item.pending_change.title) { %><h5><%= item.pending_change.title %></h5><% } %><p><%= item.pending_change.content||'The title or source details would change.' %></p><small><%= item.pending_change.reason %></small><p>The confirmed text above stays in effect until you approve this change.</p></section><% } %><div class="project-provenance"><span><%= {user_statement:'User statement',assistant_summary:'Assistant summary',inference:'Interpretation',tool_result:'Tool result'}[item.source_type]||item.source_type %></span><span><%= item.confirmation==='confirmed'?'Confirmed by owner':item.confirmation==='disputed'?'Disputed':'Proposed' %></span><span>Revision <%= item.revision %> · <%= item.updated_by||item.created_by %></span></div><% const dependencies=(board.links||[]).filter(link=>link.from_item_id===item.id).map(link=>board.items.find(value=>value.id===link.to_item_id)).filter(Boolean); if(dependencies.length) { %><details class="dependency-list"><summary>Depends on (<%= dependencies.length %>)</summary><% dependencies.forEach(dependency=>{ %><a href="#project-item-<%= dependency.id %>"><%= dependency.title %></a><% }) %></details><% } %><% if(item.source_refs&&item.source_refs.length) { %><details class="project-sources"><summary>Sources (<%= item.source_refs.length %>)</summary><% item.source_refs.forEach(source=>{ const href=sourceLink(source); %><div><% if(href) { %><a href="<%= href %>" rel="noopener noreferrer"><%= source.label||source.kind||source.collection %> ↗</a><% } else { %><strong><%= source.label||source.kind||source.collection %></strong><% } %><% if(source.excerpt) { %><p><%= source.excerpt %></p><% } %></div><% }) %></details><% } %><details <%- selectedItem===item.id?'open':'' %>><summary>Review or correct</summary><form method="post" action="<%= brainLink('/dashboard/projects/'+board.project.id+'/items/'+item.id+'/review') %>" class="project-review-form" data-project-draft><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= newRequestId() %>"><input type="hidden" name="expected_version" value="<%= board.project.version %>"><label for="review-reason-<%= item.id %>">Review note <small>Optional</small></label><input id="review-reason-<%= item.id %>" name="reason" maxlength="2000" value="<%= draft.reason||'' %>"><div class="compose-actions"><button class="dash-button lime" name="decision" value="approve"><%= item.pending_change?'Approve proposed change':'Approve this item' %></button><button class="dash-button outline" name="decision" value="dispute"><%= item.pending_change?'Keep current version':'Dispute' %></button></div></form><form method="post" action="<%= brainLink('/dashboard/projects/'+board.project.id+'/items/'+item.id) %>" class="compose-form project-correction-form" data-project-draft><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= newRequestId() %>"><input type="hidden" name="expected_version" value="<%= board.project.version %>"><label for="edit-title-<%= item.id %>">Title</label><input id="edit-title-<%= item.id %>" name="title" value="<%= draft.title??item.title %>" required maxlength="200"><label for="edit-content-<%= item.id %>">Corrected detail</label><textarea id="edit-content-<%= item.id %>" name="content" maxlength="16000"><%= draft.content??item.content %></textarea><label for="edit-status-<%= item.id %>">Status</label><select id="edit-status-<%= item.id %>" name="status"><% ['proposed','confirmed','in_progress','blocked','done','superseded'].forEach(status=>{ %><option value="<%= status %>" <%- (draft.status??item.status)===status?'selected':'' %>><%= status.replaceAll('_',' ') %></option><% }) %></select><label for="edit-reason-<%= item.id %>">Why this change?</label><input id="edit-reason-<%= item.id %>" name="reason" required maxlength="2000" value="<%= draft.reason||'' %>"><button class="dash-button outline" type="submit">Save a new revision</button></form></details></article><% }) %></section><% }) %></div></div></section><div class="project-bottom-grid"><section class="dash-panel project-events"><h2>The change trail</h2><p>Versions and recorded actions, not a full conversation transcript.</p><ol><% (board.events||[]).slice(0,8).forEach(event=>{ %><%- include('project-event',{event}) %><% }) %></ol><% if((board.events||[]).length>8) { %><details class="earlier-project-events"><summary>Earlier recorded changes (<%= board.events.length-8 %>)</summary><ol><% board.events.slice(8).forEach(event=>{ %><%- include('project-event',{event}) %><% }) %></ol></details><% } %></section><section class="dash-panel project-receipts" data-project-receipts><%- include('project-receipts',{board}) %></section></div>