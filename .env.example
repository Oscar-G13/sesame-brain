BASE_URL=https://brain.example.com
PORT=3000
HOST_PORT=3360
NODE_ENV=production
POSTGRES_PASSWORD=replace-with-a-random-long-password
DATABASE_URL=postgres://brain:replace-with-a-random-long-password@db:5432/brain
SESSION_SECRET=replace-with-64-random-hex-characters
TOKEN_PEPPER=replace-with-64-random-hex-characters
E2E_ENABLED=false

# Brain v2 — credentials stay in this gitignored mode-0600 file.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
BRAIN_MODEL_QUICK=claude-sonnet-5-5
BRAIN_MODEL_DEEP=claude-opus-5-5
BRAIN_MODEL_AUDITOR=
BRAIN_CONTEXT_TOKEN_BUDGET=20000
BRAIN_THINK_TIMEOUT_QUICK_MS=8000
BRAIN_THINK_TIMEOUT_DEEP_MS=25000
BRAIN_SESSION_IDLE_MIN=30
BRAIN_IDLE_ROLLUP_MIN=10
BRAIN_JOB_TOKEN_BUDGET=400000
BRAIN_DAILY_TOKEN_BUDGET=2000000
BRAIN_GLOBAL_DAILY_TOKEN_BUDGET=4000000
BRAIN_NIGHTLY_HOUR=3
BRAIN_NIGHTLY_TOKEN_BUDGET=600000
BRAIN_WORKSPACE_DIR=/var/lib/brain/workspaces
BRAIN_SANDBOX_URL=unix:///run/brain-sandbox/runner.sock
BRAIN_SMTP_HOST=
BRAIN_SMTP_PORT=587
BRAIN_SMTP_USER=
BRAIN_SMTP_PASS=
BRAIN_SMTP_FROM=
