{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.arxsable.ai/schema/dossier.v1.json",
  "title": "Brain conversation-derived formulation v1",
  "description": "Nonclinical, qualitative and explicitly uncertain. Never a diagnosis, test score, professional assessment or established fact about another person.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "brain_formulation"
    },
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "brain_agent_id": {
          "const": "brain-nightly"
        },
        "purpose_stated_by_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "assistant",
        "brain_agent_id"
      ]
    },
    "instructions_for_receiving_model": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "maxItems": 1000
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "region": {
          "$ref": "#/$defs/statement"
        },
        "occupation_reported": {
          "$ref": "#/$defs/statement"
        },
        "family_reported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "preferred_name"
      ],
      "patternProperties": {
        "^relationship_status_as_of_[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
          "$ref": "#/$defs/statement"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "anyOf": [
                {
                  "$ref": "#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "$ref": "#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approx_months": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end",
            "approx_months"
          ]
        },
        "sources_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        },
        "sources_not_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        },
        "only_one_side_logged": {
          "type": "boolean"
        }
      },
      "required": [
        "observation_window",
        "sources_used",
        "sources_not_used"
      ]
    },
    "evidence_labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "summarized_history": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "observed_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "unknown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "direct_statement",
        "summarized_history",
        "observed_pattern",
        "hypothesis",
        "unknown"
      ]
    },
    "confidence_scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "high": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "moderate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "low": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "high",
        "moderate",
        "low"
      ]
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        },
        "what_this_is_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "approach",
        "steps",
        "what_this_is_not"
      ]
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "timeline_of_psychologically_relevant_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "anyOf": [
              {
                "$ref": "#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_type": {
            "$ref": "#/$defs/evidenceType"
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "date",
          "evidence_type",
          "event"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_type": {
                  "const": "hypothesis"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "alternative_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "confidence",
                "alternative_explanations"
              ]
            }
          }
        ]
      },
      "maxItems": 1000
    },
    "theme_recurrence_by_month": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "theme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "months": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "maxItems": 1000
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "evidence_type": {
            "$ref": "#/$defs/evidenceType"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "theme",
          "months",
          "confidence",
          "evidence_type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_type": {
                  "const": "hypothesis"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "alternative_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "confidence",
                "alternative_explanations"
              ]
            }
          }
        ]
      },
      "maxItems": 1000
    },
    "core_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "date": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_type": {
                  "$ref": "#/$defs/evidenceType"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "alternative_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "date",
                "evidence_type",
                "detail"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "evidence_type": {
                        "const": "hypothesis"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "confidence": {
                        "$ref": "#/$defs/confidence"
                      },
                      "alternative_explanations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "minItems": 1,
                        "maxItems": 1000
                      }
                    },
                    "required": [
                      "confidence",
                      "alternative_explanations"
                    ]
                  }
                }
              ]
            },
            "maxItems": 1000
          },
          "interpretation": {
            "$ref": "#/$defs/hypothesis"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "maxItems": 1000,
            "minItems": 1
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        },
        "required": [
          "id",
          "theme",
          "description",
          "evidence",
          "interpretation",
          "alternative_explanations",
          "confidence"
        ]
      },
      "maxItems": 1000
    },
    "emotional_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frequently_expressed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "less_often_expressed_directly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "expression_style": {
          "$ref": "#/$defs/statement"
        },
        "regulation_strategies_observed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "affective_range": {
          "$ref": "#/$defs/statement"
        }
      },
      "required": [
        "frequently_expressed",
        "less_often_expressed_directly",
        "expression_style",
        "regulation_strategies_observed",
        "affective_range"
      ]
    },
    "attachment_and_relational_dynamics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "avoidance_indicators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "anxiety_indicators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "working_formulation": {
          "$ref": "#/$defs/hypothesis"
        },
        "recurring_relational_cycle": {
          "$ref": "#/$defs/hypothesis"
        },
        "boundary_style": {
          "$ref": "#/$defs/statement"
        }
      },
      "required": [
        "framework_note",
        "avoidance_indicators",
        "anxiety_indicators",
        "working_formulation",
        "recurring_relational_cycle",
        "boundary_style"
      ]
    },
    "relationships_by_person": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "relation": {
            "$ref": "#/$defs/statement"
          },
          "dated_reports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "report": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "evidence_type": {
                  "$ref": "#/$defs/evidenceType"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "alternative_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "date",
                "report",
                "evidence_type"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "evidence_type": {
                        "const": "hypothesis"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "confidence": {
                        "$ref": "#/$defs/confidence"
                      },
                      "alternative_explanations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000
                        },
                        "minItems": 1,
                        "maxItems": 1000
                      }
                    },
                    "required": [
                      "confidence",
                      "alternative_explanations"
                    ]
                  }
                }
              ]
            },
            "maxItems": 1000,
            "minItems": 1
          },
          "current_status": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "report": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "evidence_type": {
                "$ref": "#/$defs/evidenceType"
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              },
              "alternative_explanations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "minItems": 1,
                "maxItems": 1000
              }
            },
            "required": [
              "date",
              "report",
              "evidence_type"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "evidence_type": {
                      "const": "hypothesis"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "confidence": {
                      "$ref": "#/$defs/confidence"
                    },
                    "alternative_explanations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "minItems": 1,
                      "maxItems": 1000
                    }
                  },
                  "required": [
                    "confidence",
                    "alternative_explanations"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "name",
          "relation",
          "dated_reports",
          "current_status"
        ]
      },
      "maxItems": 1000
    },
    "identity_and_self_concept": {
      "$ref": "#/$defs/qualitativeSection"
    },
    "cognitive_style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 1000
        },
        "not_assessable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "observed",
        "not_assessable"
      ]
    },
    "coping_and_defenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "adaptive_side": {
