          },
          "cost": {
            "$ref": "#/$defs/statement"
          },
          "evidence_type": {
            "$ref": "#/$defs/evidenceType"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "maxItems": 1000,
            "minItems": 1
          }
        },
        "required": [
          "strategy",
          "adaptive_side",
          "cost",
          "evidence_type",
          "confidence",
          "alternative_explanations"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_type": {
                  "const": "hypothesis"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "alternative_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "maxItems": 1000,
                  "minItems": 1
                }
              },
              "required": [
                "confidence",
                "alternative_explanations"
              ]
            }
          }
        ]
      },
      "maxItems": 1000
    },
    "motivational_structure_and_values": {
      "$ref": "#/$defs/qualitativeSection"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "strength": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/statement"
            },
            "maxItems": 1000
          },
          "evidence_type": {
            "$ref": "#/$defs/evidenceType"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "strength",
