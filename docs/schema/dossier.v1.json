    "vulnerabilities_and_stressors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence_type": {
            "$ref": "#/$defs/evidenceType"
