  "$defs": {
    "date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "evidenceType": {
      "enum": [
        "direct_statement",
        "summarized_history",
        "observed_pattern",
        "hypothesis",
        "unknown"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "low"
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence_type": {
          "enum": [
            "direct_statement",
            "summarized_history",
            "observed_pattern",
            "hypothesis",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "low"
          ]
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000,
          "minItems": 1
        }
      },
      "required": [
        "text",
        "evidence_type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "hypothesis"
              }
            }
          },
          "then": {
            "required": [
              "confidence",
              "alternative_explanations"
            ],
            "properties": {
              "confidence": {
                "enum": [
                  "high",
                  "moderate",
                  "low"
                ]
              },
              "alternative_explanations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "maxItems": 1000,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "const": "hypothesis"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000,
          "minItems": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      },
      "required": [
        "evidence_type",
        "text",
        "alternative_explanations",
        "confidence"
      ]
    },
    "qualitativeSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
