        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "observations",
        "interpretation",
        "limitations"
      ]
    }
  }
